{
  "name": "@edmarkmagsalin/rubiks-cube",
  "private": false,
  "version": "0.2.0",
  "description": "Interactive 3x3 Rubik's Cube React component rendered with Three.js TSL on WebGPU, with automatic WebGL2 fallback.",
  "keywords": [
    "rubiks-cube",
    "rubik",
    "cube",
    "puzzle",
    "react",
    "react-component",
    "three",
    "threejs",
    "webgpu",
    "webgl",
    "tsl",
    "3d"
  ],
  "homepage": "https://github.com/edmarkmagsalin/rubiks-cube#readme",
  "bugs": {
    "url": "https://github.com/edmarkmagsalin/rubiks-cube/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/edmarkmagsalin/rubiks-cube.git"
  },
  "license": "MIT",
  "author": "Edmark Magsalin",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "react": ">=18",
    "three": ">=0.180.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:lib": "vite build --config vite.config.lib.ts && tsc -p tsconfig.lib.json",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "prepublishOnly": "pnpm test && pnpm build:lib"
  },
  "devDependencies": {
    "lucide-react": "^1.73.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "@babel/core": "^7.29.7",
    "@rolldown/plugin-babel": "^0.3.0",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.1"
  }
}